rules_version = '2';

// ═════════════════════════════════════════════════════════════════════════════
// Reglas de Firestore — proyecto eoe-aebs
//
// En este proyecto conviven DOS sistemas:
//   · el EOE            (Equipo de Orientación Escolar)
//   · Admisiones        (admisionesaustin.com.ar)
//
// Esta versión fusiona la propuesta del EOE con lo que Admisiones necesita.
// Publicar la propuesta del EOE tal cual deja Admisiones sin base de datos:
// su catch-all final (`if false`) cierra toda colección no listada, y ahí
// faltaban `admisiones-db`, `postulaciones-inbox` y `dg-decisiones`.
//
// Las dos reglas de oro de Firestore que explican el diseño:
//   1. Las reglas se combinan con OR. Un `allow ... if false` NO revoca lo que
//      otra regla ya permitió — por eso el catch-all permisivo tenía que salir.
//   2. Lo que no está listado, no se puede. De ahí el catch-all `if false`.
//
// ⚠️ NO PUBLICAR sin antes cargar al equipo del EOE en `eoe-usuarios`:
//    si no, nadie del EOE puede entrar.
// ═════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function miDoc() {
      return /databases/$(database)/documents/eoe-usuarios/$(request.auth.token.email.lower());
    }

    // Usuario del EOE: autenticado, cargado en eoe-usuarios y activo.
    function esUsuarioEOE() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(miDoc())
        && get(miDoc()).data.activo == true;
    }

    function esCoordinacionEOE() {
      return esUsuarioEOE() && get(miDoc()).data.rol == 'coordinacion';
    }

    // Staff de Admisiones: lista blanca explícita.
    // NO se usa `eoe-usuarios` a propósito. Cargar al equipo de Admisiones ahí
    // les daría acceso a eoe-casos, estudiantes, notas y protocolos — datos
    // clínicos de otro equipo que Admisiones no tiene por qué ver.
    // Al sumar a alguien al panel de Admisiones hay que agregarlo acá también.
    function esStaffAdmisiones() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'admisiones@austinebs-ah.edu.ar',
             'joaquin.alva@activelearning.com.ar',
             'joaquin.alva@austinebs-ah.edu.ar'
           ];
    }

    // Campos del veredicto: los escribe SOLO el EOE.
    // Admisiones los lee para rutear el pipeline y para el mail a Dirección
    // General, pero nunca los escribe (marca su avance en `pipelineAvanzado`).
    function camposDelEOE() {
      return ['resultado','bandera','estado','revisadoPor','fechaRevision',
              'observacionesEOE','motivoRechazo','motivoArchivo'];
    }

    function noTocaCamposDelEOE() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(camposDelEOE());
    }

    // Una escritura que toca SOLO los campos de la lista. Lo usa la agenda pública del
    // EOE, donde escribe la familia sin cuenta: acota qué puede cambiar de un turno.
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // El casoId al que corresponde un token de agendamiento. Si el token no existe, el
    // get() devuelve null, leer .data falla y la regla deniega: no se reserva sin link.
    function casoDelToken(token) {
      return get(/databases/$(database)/documents/agendamiento-publico/$(token)).data.casoId;
    }


    // ═══ EOE — interno ═══════════════════════════════════════════════════════

    // Directorio del equipo del EOE. Todos leen, solo coordinación edita.
    // Nadie borra: se desactiva con `activo: false`.
    match /eoe-usuarios/{email} {
      // Cada uno lee su propio documento. NO es redundante con el `list` de abajo:
      // esUsuarioEOE() exige `activo == true`, así que alguien desactivado no entraría
      // por ahí y el login no podría distinguir "dado de baja" de "nunca existió".
      allow get:    if request.auth != null
                    && request.auth.token.email.lower() == email;

      // Todo el EOE lee el directorio de su propio equipo: quién lleva cada caso, quién
      // hace cada entrevista y de qué color se pinta en la agenda. Sin esto los
      // desplegables de responsable salen vacíos y la agenda queda en gris.
      // Solo lectura — el alta, el cambio de rol y la baja siguen siendo de coordinación.
      allow get, list: if esUsuarioEOE();

      allow create, update: if esCoordinacionEOE();

      // Cada uno marca su propio último acceso al entrar. Solo ese campo: no puede
      // cambiarse el rol ni reactivarse solo. Sin esto la columna "último acceso" de la
      // pantalla de Usuarios queda congelada para todos menos coordinación.
      allow update: if request.auth != null
                    && request.auth.token.email.lower() == email
                    && soloCambia(['ultimoAcceso']);

      allow delete: if false;
    }

    // Se escribe, no se corrige. Una auditoría editable no sirve de nada.
    match /eoe-auditoria/{id} {
      allow read, create:   if esUsuarioEOE();
      allow update, delete: if false;
    }

    // Config y plantillas de mail: todos leen, solo coordinación edita.
    match /eoe-config/{doc} {
      allow read:  if esUsuarioEOE();
      allow write: if esCoordinacionEOE();
    }

    // Expediente del EOE y archivo permanente. Admisiones nunca entra acá.
    match /eoe-casos/{id}            { allow read, write: if esUsuarioEOE(); }
    match /admisiones-historial/{id} { allow read, write: if esUsuarioEOE(); }

    // Trayectorias estudiantiles y seguimiento.
    match /estudiantes/{id} {
      allow read, write: if esUsuarioEOE();
      match /{sub=**} { allow read, write: if esUsuarioEOE(); }
    }
    match /alertas-seguimiento/{id} {
      allow read, write: if esUsuarioEOE();
      match /{sub=**} { allow read, write: if esUsuarioEOE(); }
    }
    // Fila de espera de mails. El EOE deja el pedido acá desde el navegador; el motor de
    // Apps Script lo levanta cada 5 minutos y lo manda.
    //
    // El motor entra con cuenta de servicio, que NO pasa por estas reglas (las service
    // accounts con permiso de Datastore las saltean): por eso puede marcar el documento
    // como enviado aunque acá el update esté cerrado.
    //
    // Cerrado igual que eoe-auditoria: desde el navegador nadie edita ni borra un envío ya
    // encolado. Si se pudiera, un mail ya mandado podría reescribirse y el registro mentiría.
    match /cola-mails/{id} {
      allow read, create:   if esUsuarioEOE();
      allow update, delete: if false;
    }

    match /notas/{id}                   { allow read, write: if esUsuarioEOE(); }
    match /protocolos/{id}              { allow read, write: if esUsuarioEOE(); }
    match /protocolos-diag/{id}         { allow read, write: if esUsuarioEOE(); }
    match /eventos-institucionales/{id} { allow read, write: if esUsuarioEOE(); }


    // ═══ ADMISIONES — interno ════════════════════════════════════════════════

    // La base de datos del panel: postulantes, padrón, entrevistas, plantillas
    // de mail, tarifas, config. Sin esta regla el panel no abre.
    match /admisiones-db/{doc} {
      allow read, write: if esStaffAdmisiones();
    }

    // Bandeja del formulario público de familias. Alta abierta porque la
    // familia no tiene cuenta, pero acotada: un solo string, sin campos extra
    // y con tope de tamaño. Leerla y vaciarla es solo del staff.
    match /postulaciones-inbox/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['data','ts','procesado'])
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 50000;
      allow read, update, delete: if esStaffAdmisiones();
    }

    // El clic de Dirección General en el mail (Aprobar / Rechazar). Lo escribe
    // Apps Script, que corre sin sesión de Firebase: por eso el create queda
    // abierto. El daño posible es acotado —solo se puede crear una decisión— y
    // el panel aplica la primera que encuentra y la marca procesada.
    match /dg-decisiones/{id} {
      allow create: if true;
      allow read, update, delete: if esStaffAdmisiones();
    }


    // ═══ FRONTERA EOE ↔ ADMISIONES ═══════════════════════════════════════════

    // El caso que Admisiones manda a revisar y el EOE cierra semanas después.
    //
    // Admisiones escribe autenticado (comparte este proyecto Firebase, así que
    // la sesión del staff ya sirve). Por eso el create dejó de estar abierto a
    // internet, y no hace falta ni service account ni abrir el update.
    //
    // La doble condición del update es el contrato hecho regla: Admisiones
    // puede corregir los datos de la familia, pero el veredicto, la bandera y
    // el estado son del EOE y no los puede tocar ni por error ni a propósito.
    //
    // Admisiones NO borra el documento: el EOE hace update sobre él al cerrar,
    // y si no existe el cierre falla. El delete queda solo del lado del EOE.
    match /admisiones-revision/{id} {
      allow create: if esUsuarioEOE() || esStaffAdmisiones();
      allow read:   if esUsuarioEOE() || esStaffAdmisiones();
      allow update: if esUsuarioEOE() || (esStaffAdmisiones() && noTocaCamposDelEOE());
      allow delete: if esUsuarioEOE();
    }

    // El alta, que Admisiones escribe recién cuando el circuito terminó
    // (EOE aprobó + Dirección General confirmó). Acá no hay campos reservados:
    // el `estado` de esta colección lo maneja Admisiones.
    match /matriculados-pendientes/{id} {
      allow create, read, update: if esUsuarioEOE() || esStaffAdmisiones();
      allow delete: if esUsuarioEOE();
    }


    // ═══ EOE — agenda pública (la familia entra SIN CUENTA) ══════════════════
    //
    // Módulo `agendar.html` del EOE: la familia llega desde un link con un token que
    // recibió por mail y elige su turno de entrevista sin autenticarse.
    //
    // Nada de esto es de Admisiones. Sus entrevistas no son una colección de Firestore:
    // viven como campos (entFecha / entHora) dentro de admisiones-db/v2, y los turnos del
    // formulario público los maneja Apps Script. No hay colisión de nombres.

    // Turnos de entrevista del EOE. Conviven dos mundos: el equipo, que puede todo, y la
    // familia, que sólo ve los turnos LIBRES. Un turno reservado guarda el casoId y el
    // token de otra familia: si fuera legible, con abrir la página se vería quién tiene
    // entrevista y cuándo. Son datos de menores — por eso tampoco se guarda nunca el
    // nombre del estudiante acá: ese vive en el expediente, que exige cuenta.
    match /entrevistas/{id} {
      allow read, write: if esUsuarioEOE();

      // ⚠️ Para el `list`, Firestore evalúa esta condición contra cada documento
      // candidato: agendar.html tiene que consultar filtrando por estado == 'libre', y
      // ningún documento de la colección puede quedar sin el campo `estado`. Si no, la
      // consulta entera se rechaza y la familia ve la pantalla sin horarios.
      allow get, list: if resource.data.estado == 'libre';

      // Tomar un turno libre. El casoId que escribe tiene que ser el de SU token: no
      // puede reservar a nombre de otra familia.
      allow update: if resource.data.estado == 'libre'
                    && request.resource.data.estado == 'reservado'
                    && request.resource.data.reservadoPor == 'familia'
                    && request.resource.data.sincronizado == false
                    && request.resource.data.tokenReserva is string
                    && request.resource.data.casoId == casoDelToken(request.resource.data.tokenReserva)
                    && soloCambia(['estado','casoId','reservadoEn','reservadoPor',
                                   'tokenReserva','sincronizado']);

      // Cancelar el propio turno. Hay que aportar el mismo token con el que se reservó
      // —que la familia tiene en su link y que nadie más puede leer, porque un turno
      // reservado no es legible sin cuenta.
      allow update: if resource.data.estado == 'reservado'
                    && resource.data.tokenReserva is string
                    && resource.data.tokenReserva != ''
                    && request.resource.data.tokenReserva == resource.data.tokenReserva
                    && request.resource.data.estado == 'cancelado'
                    && request.resource.data.canceladoPor == 'familia'
                    && request.resource.data.sincronizado == false
                    && soloCambia(['estado','canceladoPor','canceladoEn',
                                   'tokenReserva','sincronizado']);
    }

    // Lo mínimo que necesita ver agendar.html: nombre del estudiante y el turno que tiene.
    // Nada de mail, teléfono, observaciones ni bandera — eso se queda en eoe-casos.
    //
    // `get` abierto y `list` cerrado es toda la seguridad de esta colección: el id del
    // documento es un token aleatorio de 48 caracteres hex que sólo está en el mail de esa
    // familia. Sin el token no se llega a nada, y la colección no se puede recorrer.
    match /agendamiento-publico/{token} {
      allow read, write: if esUsuarioEOE();

      allow get:  if true;
      allow list: if false;

      // La familia deja anotado el turno que tomó (o lo borra al cancelar). El motor lo
      // reescribe desde `entrevistas` en la corrida siguiente, así que aunque alguien con
      // el token escribiera cualquier cosa acá, no cambia qué turno tiene de verdad.
      //
      // `turno` es un map de cuatro strings, o `null` cuando la familia cancela:
      // sin el `== null` la cancelación se rechaza. Los topes de tamaño están para
      // que nadie con un token válido use este campo como depósito de datos.
      // `fecha` y `hora` van con `<=` y no `==` a propósito: el tope frena igual, y
      // una igualdad estricta rompería si un turno quedara como '9:30' y no '09:30'.
      allow update: if soloCambia(['turno','actualizadoEn'])
                    && request.resource.data.actualizadoEn is number
                    && (request.resource.data.turno == null || (
                         request.resource.data.turno.keys()
                           .hasOnly(['entrevistaId','fecha','hora','modalidad'])
                         && request.resource.data.turno.entrevistaId is string
                         && request.resource.data.turno.entrevistaId.size() <= 64
                         && request.resource.data.turno.fecha is string
                         && request.resource.data.turno.fecha.size() <= 10
                         && request.resource.data.turno.hora is string
                         && request.resource.data.turno.hora.size() <= 5
                         && request.resource.data.turno.modalidad is string
                         && request.resource.data.turno.modalidad.size() <= 20
                       ));
    }


    // ═══ Todo lo demás: cerrado ══════════════════════════════════════════════
    // Sin esto, una colección nueva nacería sin reglas. Mejor que falle a que
    // quede abierta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
